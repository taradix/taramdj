# Required. Primary cert CN. Must match a live/<SERVER_HOSTNAME>/ directory
# under /etc/letsencrypt once the cert has been issued.
SERVER_HOSTNAME=mdj.taram.ca

# Recommended. Space-separated compose service names to SIGHUP after each
# successful renewal.
RELOAD_SERVICES=nginx

# Docker network. Must not collide with the other tara* projects on the host.
IPV4_NETWORK=172.22.8

# Required. The public Google spreadsheet holding the events. SHEET_ID is the
# long id in the sheet URL; the sheet must be shared "Tous les utilisateurs
# disposant du lien" with read access. SHEET_TAB is the tab (onglet) name.
SHEET_ID=
SHEET_TAB=Evenements
